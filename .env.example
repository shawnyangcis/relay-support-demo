# On Vercel, AI Gateway authenticates automatically with deployment OIDC.
# For local development only, set a key or use vercel env pull.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-5.4-mini

# Optional direct provider. Takes precedence over AI Gateway when the key is set.
CHAT_API_KEY=
CHAT_BASE_URL=https://api.longcat.chat/openai/v1
CHAT_MODEL=LongCat-2.5
